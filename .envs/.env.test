# Environment
ENVIRONMENT=test

# Docker Configuration
LOCAL_PORT=8080
DOCKER_PORT=8080

# Database Postgres Configuration
DATABASE_TYPE=postgresql
DATABASE_HOST=ifrn-chamados-postgres
DATABASE_PORT=5432
DATABASE_DB=ifrn_chamados_test_db
DATABASE_USER=ifrn_chamados_test_user
DATABASE_PASSWORD=ifrn_chamados_test_password

# JPA Configuration
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
